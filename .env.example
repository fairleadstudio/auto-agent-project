# Copy to .env on the VPS only. Never commit .env. The agent cannot read it.

# Model access. Prepaid credits, auto top-up OFF, key limit set to the operating budget.
OPENROUTER_API_KEY=

# Owner identity, used by scripts/verify_owner.sh
OWNER_EMAIL=fairleadstudio@gmail.com
# Path to an SSH allowed_signers file containing the Owner's signing key.
# Format per line: "<email> <key-type> <public-key>". Enables signature verification.
OWNER_ALLOWED_SIGNERS=/home/agent/.config/git/allowed_signers

# Cloudflare analytics (scoped token: Zone Analytics Read only)
CF_API_TOKEN=
CF_ZONE_ID=

# Merchant of record, read scope only (payments in). Fill once chosen.
MOR_PROVIDER=
MOR_API_KEY=

# Git remote for push (deploy key configured separately in ~/.ssh)
GIT_REMOTE=origin
GIT_BRANCH=main
